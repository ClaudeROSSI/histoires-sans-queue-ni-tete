---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes?: string;
  prioritaire?: boolean;
}
const { image, alt, sizes = '(min-width: 48rem) 30rem, 92vw', prioritaire = false } = Astro.props;
const vectoriel = image.format === 'svg';
---
{
  vectoriel ? (
    <img
      src={image.src}
      alt={alt}
      width={image.width}
      height={image.height}
      loading={prioritaire ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading={prioritaire ? 'eager' : 'lazy'}
    />
  )
}
